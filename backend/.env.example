# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ai_language_learning
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_language_learning
DB_USER=username
DB_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key
JWT_EXPIRES_IN=7d

# OpenRouter API Configuration
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI Model Configuration
DEFAULT_AI_MODEL=openai/gpt-4o
CHAT_MODEL=openai/gpt-4o
PRACTICE_GENERATION_MODEL=openai/gpt-4o
ANALYSIS_MODEL=openai/gpt-4o
ASSESSMENT_MODEL=openai/gpt-4o
VOCABULARY_MODEL=openai/gpt-4o
FUNCTION_CALLING_MODEL=openai/gpt-4o
INTENT_RECOGNITION_MODEL=openai/gpt-4o
DAILY_RECOMMENDATION_MODEL=openai/gpt-4o

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Payment Configuration
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret