{
  "name": "ai-language-learning-backend",
  "version": "1.0.0",
  "description": "Backend API for AI Language Learning Application",
  "main": "dist/server.js",
  "scripts": {
    "start": "node --max-old-space-size=1024 dist/server.js",
    "dev": "node --max-old-space-size=1024 node_modules/nodemon/bin/nodemon.js src/server.ts",
    "build": "node --max-old-space-size=1024 node_modules/typescript/bin/tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=\"src/test/unit\"",
    "test:unit:watch": "jest --watch --testPathPattern=\"src/test/unit\"",
    "test:property": "jest --config jest.property.config.js --forceExit",
    "test:property:watch": "jest --config jest.property.config.js --watch",
    "test:integration": "jest --testPathPattern=\"src/test/integration\"",
    "test:coverage": "jest --coverage",
    "test:db:start": "docker-compose -f ../docker-compose.test.yml up -d",
    "test:db:stop": "docker-compose -f ../docker-compose.test.yml down",
    "test:db:setup": "npm run test:db:start && sleep 5",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "migrate:up": "ts-node src/config/migration.ts up",
    "migrate:rollback": "ts-node src/config/migration.ts rollback",
    "db:seed": "psql $DATABASE_URL -f database/seeds/001_sample_data.sql"
  },
  "dependencies": {
    "axios": "^1.3.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^6.14.0",
    "helmet": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.8.0",
    "redis": "^4.5.0",
    "socket.io": "^4.6.0",
    "uuid": "^9.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^18.0.0",
    "@types/pg": "^8.6.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^5.50.0",
    "@typescript-eslint/parser": "^5.50.0",
    "eslint": "^8.33.0",
    "fast-check": "^3.6.0",
    "jest": "^29.0.0",
    "nodemon": "^2.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^4.9.0"
  },
  "keywords": [
    "ai",
    "language-learning",
    "nodejs",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
