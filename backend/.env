# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5433/ai_language_learning_test
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ai_language_learning_test
DB_USER=postgres
DB_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=dev-super-secret-jwt-key-for-development-only
JWT_REFRESH_SECRET=dev-super-secret-jwt-refresh-key-for-development-only
JWT_EXPIRES_IN=7d

# OpenRouter API Configuration
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI Model Configuration
DEFAULT_AI_MODEL=anthropic/claude-haiku-4.5
CHAT_MODEL=anthropic/claude-haiku-4.5
PRACTICE_GENERATION_MODEL=anthropic/claude-haiku-4.5
ANALYSIS_MODEL=anthropic/claude-haiku-4.5
ASSESSMENT_MODEL=anthropic/claude-haiku-4.5
VOCABULARY_MODEL=anthropic/claude-haiku-4.5
FUNCTION_CALLING_MODEL=anthropic/claude-haiku-4.5
INTENT_RECOGNITION_MODEL=anthropic/claude-haiku-4.5
DAILY_RECOMMENDATION_MODEL=anthropic/claude-haiku-4.5

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Payment Configuration
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret