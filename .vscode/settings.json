{
  // ==================== TypeScript 和编译器设置 ====================
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.updateImportsOnFileMove.enabled": "prompt",
  "typescript.implementationsCodeLens.enabled": true,
  "typescript.referencesCodeLens.enabled": true,
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },

  // ==================== ESLint 设置 ====================
  "eslint.validate": [
    "typescript",
    "typescriptreact",
    "javascript",
    "javascriptreact"
  ],
  "eslint.format.enable": true,
  "eslint.lintTask.enable": true,
  "eslint.workingDirectories": [
    "backend",
    "frontend"
  ],

  // ==================== Prettier 设置 ====================
  "prettier.printWidth": 100,
  "prettier.tabWidth": 2,
  "prettier.useTabs": false,
  "prettier.semi": true,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "es5",

  // ==================== 代码编辑器设置 ====================
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.trimAutoWhitespace": true,
  "editor.rulers": [80, 100, 120],
  "editor.codeLens": true,
  "editor.inlayHints.enabled": true,
  "editor.inlayHints.variableTypes": true,
  "editor.inlayHints.parameterTypes": true,
  "editor.inlayHints.functionReturnTypes": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.minimap.enabled": true,

  // ==================== Jest 测试设置 ====================
  "jest.autoRun": "off",
  "jest.showCoverageOnLoad": false,
  "jest.runMode": "on-demand",
  "jest.jestCommandLine": "cd backend && npm test",

  // ==================== Makefile 设置 ====================
  "makefile.configureOnOpen": true,
  "makefile.dryRunAfterConfigure": false,
  "makefile.showTerminalOnRun": true,

  // ==================== Docker 设置 ====================
  "docker.showExplorer": true,
  "docker.containers.label": "name",
  "docker.images.label": "name",

  // ==================== Git 和 GitLens 设置 ====================
  "gitlens.codeLens.enabled": true,
  "gitlens.codeLens.recentChange.enabled": true,
  "gitlens.hovers.currentLine.enabled": true,
  "gitlens.blame.enabled": true,
  "gitlens.currentLine.enabled": true,

  // ==================== 文件和搜索 ====================
  "files.exclude": {
    "**/.git": false,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/coverage": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/dist/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true
  },

  // ==================== 文件关联 ====================
  "files.associations": {
    "*.env.example": "properties",
    "*.env.local": "properties",
    "Makefile": "makefile",
    "docker-compose*.yml": "yaml"
  },

  // ==================== 终端设置 ====================
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "/bin/bash",
      "icon": "terminal-bash"
    }
  },

  // ==================== 错误 Lens 设置 ====================
  "errorLens.enabledDiagnosticLevels": [
    "warning",
    "error"
  ],
  "errorLens.messageTemplate": "$message ($code)",

  // ==================== 代码片段 ====================
  "editor.snippetSuggestions": "top",

  // ==================== 扩展行为 ====================
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // ==================== 生产力工具 ====================
  "todo-tree.tree.showScanOpenFilesOrFolders": true,
  "todo-tree.highlights.defaultHighlight": {
    "foreground": "white",
    "background": "#cc9900",
    "iconColor": "#ffbb00",
    "type": "tag"
  },
  "todo-tree.highlights.customHighlight": {
    "FIXME": {
      "background": "#cc3333",
      "icon": "flame",
      "iconColor": "#ff0000"
    },
    "HACK": {
      "background": "#cc33cc",
      "icon": "beaker",
      "iconColor": "#ff00ff"
    },
    "REVIEW": {
      "background": "#0066cc",
      "icon": "eye",
      "iconColor": "#0088ff"
    }
  },

  // ==================== 主题设置 ====================
  "workbench.colorTheme": "Material Theme Darker",
  "workbench.iconTheme": "material-icon-theme",
  "material-icon-theme.files.associations": {
    "Makefile": "makefile",
    ".env.example": "environment",
    "tsconfig.json": "settings",
    "jest.config.js": "jest"
  },

  // ==================== 窗口和界面 ====================
  "workbench.startupEditor": "welcomePage",
  "workbench.editor.enablePreview": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "explorer.openEditors.visible": 5
}
